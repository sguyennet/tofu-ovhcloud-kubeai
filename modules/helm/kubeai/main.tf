resource "kubectl_manifest" "namespace" {
  yaml_body = yamlencode({
    apiVersion = "v1"
    kind       = "Namespace"
    metadata = {
      name = var.namespace
      labels = {
        name = var.namespace
      }
    }
  })

  wait_for {
    field {
      key   = "status.phase"
      value = "Active"
    }
  }
}

# Bootstraps the Open WebUI admin account without going through the sign up form.
resource "kubectl_manifest" "open_webui_admin_secret" {
  depends_on = [kubectl_manifest.namespace]

  yaml_body = yamlencode({
    apiVersion = "v1"
    kind       = "Secret"
    metadata = {
      name      = local.admin_secret_name
      namespace = var.namespace
    }
    type = "Opaque"
    stringData = {
      password = var.admin_password
    }
  })

  sensitive_fields = ["stringData.password"]
}

# Credentials for a private repository holding the engine image. A public one
# needs none, which is the empty-username case and creates nothing.
#
# The count reads a variable rather than anything computed from a resource: a
# count cannot depend on a value that is only known at apply time, so keep this
# fed from an input variable.
resource "kubectl_manifest" "registry_pull_secret" {
  count      = var.registry_username == "" ? 0 : 1
  depends_on = [kubectl_manifest.namespace]

  yaml_body = yamlencode({
    apiVersion = "v1"
    kind       = "Secret"
    metadata = {
      name      = local.registry_secret_name
      namespace = var.namespace
    }
    type = "kubernetes.io/dockerconfigjson"
    stringData = {
      ".dockerconfigjson" = jsonencode({
        auths = {
          (var.registry_host) = {
            username = var.registry_username
            password = var.registry_password
            auth     = base64encode("${var.registry_username}:${var.registry_password}")
          }
        }
      })
    }
  })

  sensitive_fields = ["stringData"]
}

# Open WebUI reads the Valkey URL, password included, from this secret rather than
# from a value rendered into the Helm release.
resource "kubectl_manifest" "open_webui_redis_secret" {
  depends_on = [kubectl_manifest.namespace]

  yaml_body = yamlencode({
    apiVersion = "v1"
    kind       = "Secret"
    metadata = {
      name      = local.redis_secret_name
      namespace = var.namespace
    }
    type = "Opaque"
    stringData = {
      "redis-url" = local.redis_url
    }
  })

  sensitive_fields = ["stringData.redis-url"]
}

# Everything Open WebUI needs to reach its shared state, and the key that lets two
# pods read each other's sessions.
resource "kubectl_manifest" "open_webui_state_secret" {
  depends_on = [kubectl_manifest.namespace]

  yaml_body = yamlencode({
    apiVersion = "v1"
    kind       = "Secret"
    metadata = {
      name      = local.state_secret_name
      namespace = var.namespace
    }
    type = "Opaque"
    stringData = {
      "database-url"         = local.database_url
      "secret-key"           = var.secret_key
      "s3-access-key-id"     = var.s3_access_key_id
      "s3-secret-access-key" = var.s3_secret_access_key
    }
  })

  sensitive_fields = [
    "stringData.database-url",
    "stringData.secret-key",
    "stringData.s3-access-key-id",
    "stringData.s3-secret-access-key",
  ]
}

locals {
  admin_secret_name = "openwebui-admin-secret"

  # Pull credentials for a private repository holding the engine image.
  registry_secret_name = "kubeai-registry"
  redis_secret_name    = "openwebui-redis-secret"
  state_secret_name    = "openwebui-state-secret"

  # OVHcloud managed PostgreSQL only accepts TLS connections. Open WebUI
  # normalises the libpq parameter for the driver it ends up using, sync or
  # async, so sslmode belongs in the URL. The password is generated by the API and
  # can hold characters that mean something in a URL, so it is escaped.
  database_url = format(
    "postgresql://%s:%s@%s:%s/%s?sslmode=require",
    var.postgres_username,
    urlencode(var.postgres_password),
    var.postgres_host,
    var.postgres_port,
    var.postgres_database,
  )

  # OVHcloud managed Valkey only listens in TLS, hence rediss. Its certificate is
  # signed by a private OVHcloud CA that is absent from the Open WebUI image trust
  # store and, unlike the other engines, the API exposes no endpoint the
  # configuration could read it from, so the client is told not to verify the
  # chain. The connection stays encrypted and never leaves the private subnet.
  #
  # The password is generated by the API and can hold characters that mean
  # something in a URL, so it is escaped rather than interpolated as is.
  redis_url = format(
    "rediss://%s:%s@%s:%s/0?ssl_cert_reqs=none",
    var.valkey_username,
    urlencode(var.valkey_password),
    var.valkey_host,
    var.valkey_port,
  )

  # Rate limiting keyed on the token rather than on the client address, so the
  # interface and the OpenAI compatible API are covered by the same rule even
  # though their tokens differ: a session is a JWT, an editor sends an sk- key,
  # and the bucket is simply the hash of whichever one is presented. Requests
  # carrying neither, the login and sign up pages and the static assets, are
  # tracked on the client address instead and never hit a token bucket.
  #
  # A backend snippet: the built-in rate limit annotations of the controller can
  # only track "src", and would count authenticated requests too.
  rate_limit_snippet = <<-EOT
    stick-table type string len 40 size 100k expire ${var.rate_limit_window} store http_req_rate(${var.rate_limit_window})
    http-request track-sc0 req.hdr(Authorization),sha1,hex if { req.hdr(Authorization) -m found }
    http-request track-sc1 req.cook(token),sha1,hex if !{ req.hdr(Authorization) -m found } { req.cook(token) -m found }
    http-request track-sc2 src if !{ req.hdr(Authorization) -m found } !{ req.cook(token) -m found }
    http-request deny deny_status 429 if { sc_http_req_rate(0) gt ${var.rate_limit_requests} }
    http-request deny deny_status 429 if { sc_http_req_rate(1) gt ${var.rate_limit_requests} }
    http-request deny deny_status 429 if { sc_http_req_rate(2) gt ${var.rate_limit_unauthenticated_requests} }
  EOT

  # Reads the admin configuration and writes it back with the sign up switch set
  # where enable_signup asks for it, so the declared value wins in both
  # directions. The whole document has to be sent back, the endpoint takes no
  # partial update. Open WebUI answers only once it has finished starting, hence
  # the retries on the sign in.
  signup_script = <<-EOT
    import json
    import os
    import time
    import urllib.request

    base = os.environ["BASE_URL"]
    desired = os.environ["ENABLE_SIGNUP"] == "True"


    def call(path, token=None, payload=None):
        request = urllib.request.Request(
            base + path,
            method="GET" if payload is None else "POST",
            headers={"Content-Type": "application/json"},
            data=None if payload is None else json.dumps(payload).encode(),
        )
        if token:
            request.add_header("Authorization", "Bearer " + token)
        with urllib.request.urlopen(request, timeout=30) as answer:
            return json.load(answer)


    token = None
    for attempt in range(30):
        try:
            token = call(
                "/api/v1/auths/signin",
                payload={
                    "email": os.environ["ADMIN_EMAIL"],
                    "password": os.environ["ADMIN_PASSWORD"],
                },
            )["token"]
            break
        except Exception as error:
            print("waiting for Open WebUI:", error, flush=True)
            time.sleep(10)

    if token is None:
        raise SystemExit("Open WebUI never answered")

    config = call("/api/v1/auths/admin/config", token=token)

    if config["ENABLE_SIGNUP"] == desired:
        print("sign up already set to", desired)
    else:
        config["ENABLE_SIGNUP"] = desired
        call("/api/v1/auths/admin/config", token=token, payload=config)
        print("sign up set to", desired)
  EOT

  ingress_annotations = merge(
    {
      "cert-manager.io/cluster-issuer" = var.certificate_issuer
    },
    length(var.allow_list) == 0 ? {} : {
      "haproxy.org/allow-list" = join(",", var.allow_list)
    },
    var.rate_limit_requests == "" ? {} : {
      "haproxy.org/backend-config-snippet" = local.rate_limit_snippet
    }
  )

  values = {
    # KubeAI controller, the model pods are placed by their resource profile.
    nodeSelector = var.node_selector

    resourceProfiles = var.resource_profiles

    # Where KubeAI keeps the weights of a model that asks for it. It downloads
    # them once onto the shared volume and every replica reads them from there,
    # which is what turns the six minutes a cold replica spends pulling from
    # Hugging Face into a read over the private network.
    #
    # Written as a comprehension rather than a conditional so that the empty case
    # is a map of the same type, which a ternary between an object and {} is not.
    cacheProfiles = {
      for name in(var.cache_storage_class == "" ? [] : [var.cache_profile_name]) :
      name => {
        sharedFilesystem = {
          storageClassName = var.cache_storage_class
          storageSize      = var.cache_storage_size
        }
      }
    }

    # Only the nvidia-gpu entry is overridden: it is the one every model here
    # resolves to through its resource profile, and the pruned image is built for
    # one GPU. The cpu and amd-gpu entries keep pointing at the chart's own
    # references, so a model on another profile still starts.
    #
    # Written as a comprehension for the same reason as cacheProfiles above: the
    # empty case has to be a map of the same type, which a ternary against {} is
    # not, and an empty modelServers leaves the chart's defaults untouched.
    # One list, which the chart renders in two places: onto the controller
    # deployment, and into the modelServerPods section of the KubeAI config,
    # which is what puts it on the model pods. There is no
    # modelServerPods.imagePullSecrets value to set instead; this is the value
    # the chart offers, and its own comment says it covers both.
    imagePullSecrets = var.registry_username == "" ? [] : [
      { name = local.registry_secret_name }
    ]

    modelServers = {
      for engine in(var.vllm_image == "" ? [] : ["VLLM"]) :
      engine => {
        images = {
          "nvidia-gpu" = var.vllm_image
        }
      }
    }

    "open-webui" = {
      enabled          = true
      openaiBaseApiUrl = "http://kubeai/openai/v1"
      nodeSelector     = var.node_selector
      replicaCount     = var.replica_count

      # Sticky sessions, carried on the service rather than the ingress: the
      # controller deprecated the ingress form, and the cookie it inserts is a
      # dynamic one, which is what keeps persistence working across the several
      # replicas of the ingress controller itself.
      service = {
        annotations = var.session_cookie == "" ? {} : {
          "haproxy.org/cookie-persistence" = var.session_cookie
        }
      }

      # Migrations run as the application starts, they take no lock, and Open
      # WebUI is explicit that two instances must never migrate the same database
      # at once. A StatefulSet starts its pods one at a time and waits for each to
      # be ready before the next, which is what keeps the second pod out of the
      # migration the first one runs. The chart would otherwise render a
      # Deployment here, since the storage below is not a volume claim, and both
      # pods would come up together. Nothing is stored per pod, the volume is an
      # emptyDir either way.
      #
      # This orders the pods, it does not make a version bump safe: an upgrade
      # that changes the schema still wants every pod on the new image rather than
      # a rolling replacement.
      workload = {
        kind = "StatefulSet"
      }

      # Nothing of value is kept on the pod any more: the database and the vector
      # store are in PostgreSQL, the uploads and the generated images in Object
      # Storage. Naming a provider other than local is also what makes the chart
      # drop the volume claim and render a Deployment rather than a StatefulSet,
      # which is what lets the pods scale out.
      persistence = {
        enabled  = true
        provider = "s3"

        s3 = {
          endpointUrl = var.s3_endpoint_url
          region      = var.s3_region
          bucket      = var.s3_bucket

          accessKeyExistingSecret    = local.state_secret_name
          accessKeyExistingAccessKey = "s3-access-key-id"
          secretKeyExistingSecret    = local.state_secret_name
          secretKeyExistingSecretKey = "s3-secret-access-key"
        }
      }

      # Two things at once. Open WebUI keeps the settings it marks
      # PersistentConfig in Redis as soon as REDIS_URL is set and reads them back
      # on every start, which is how the sign up switch written by the job below
      # outlives the pod. And Socket.IO needs a shared broker to carry an event
      # between replicas, without which a browser only ever hears from the pod it
      # happens to be talking to.
      #
      # The chart fills REDIS_URL and WEBSOCKET_REDIS_URL from the same secret.
      # Its own bundled Redis, a plain Deployment with no storage, is left off:
      # the managed Valkey cluster outlives both the pod and the release.
      websocket = {
        enabled           = true
        manager           = "redis"
        existingSecret    = local.redis_secret_name
        existingSecretKey = "redis-url"

        redis = {
          enabled = false
        }
      }

      ingress = {
        enabled = true
        class   = var.ingress_class
        host    = var.fqdn
        # Leaves the TLS secret to cert-manager, which reads the annotation below.
        tls         = true
        annotations = local.ingress_annotations
      }

      extraEnvVars = [
        {
          name  = "WEBUI_AUTH"
          value = "True"
        },
        {
          name  = "OPENAI_API_KEYS"
          value = "not-used"
        },
        {
          name  = "SHOW_ADMIN_DETAILS"
          value = var.show_admin_details
        },
        {
          name  = "SAFE_MODE"
          value = "true"
        },
        {
          name  = "ENABLE_EVALUATION_ARENA_MODELS"
          value = "False"
        },
        {
          name  = "WEBUI_URL"
          value = "https://${var.fqdn}"
        },
        # Headless admin bootstrap.
        {
          name  = "WEBUI_ADMIN_EMAIL"
          value = var.admin_email
        },
        {
          name = "WEBUI_ADMIN_PASSWORD"
          valueFrom = {
            secretKeyRef = {
              name = local.admin_secret_name
              key  = "password"
            }
          }
        },
        {
          name  = "WEBUI_ADMIN_NAME"
          value = "Admin"
        },
        # Self registration. A new account is created with the "pending" role and
        # cannot sign in until an administrator activates it from the admin panel.
        #
        # ENABLE_SIGNUP is only the value the configuration store is seeded with
        # on a first start, and it does not survive it: bootstrapping the admin
        # account above turns self registration off, deliberately and one line
        # later. The job at the end of this file is what actually holds the
        # switch where enable_signup asks for it.
        {
          name  = "ENABLE_SIGNUP"
          value = var.enable_signup
        },
        {
          name  = "ENABLE_LOGIN_FORM"
          value = "True"
        },
        {
          name  = "DEFAULT_USER_ROLE"
          value = var.default_user_role
        },
        # A model served through the OpenAI connection, which is how every KubeAI
        # model reaches Open WebUI, has no row of its own in the Open WebUI model
        # table, and an unconfigured model is deliberately shown to
        # administrators only: "No DB entry means no access control configured
        # yet". A freshly registered user would sign in to an empty model list.
        #
        # Lifting the filter is what makes the models public here. It is a plain
        # startup variable rather than a PersistentConfig one, so it holds on its
        # own, without a trip through Valkey. Giving the model a row and a public
        # access grant, from Workspace, Models, is the other way, and the one to
        # prefer as soon as the models are not all meant for everyone.
        {
          name  = "BYPASS_MODEL_ACCESS_CONTROL"
          value = var.public_models
        },
        # Shared state, the three things two pods cannot each keep their own copy
        # of. The database carries the accounts and the conversations, and the
        # vector store rides in it on the pgvector extension rather than in the
        # ChromaDB of the pod, whose SQLite is not safe across processes. The
        # secret key signs the session tokens, and a pod that generated its own
        # would reject every token issued by the other one.
        {
          name = "DATABASE_URL"
          valueFrom = {
            secretKeyRef = {
              name = local.state_secret_name
              key  = "database-url"
            }
          }
        },
        {
          name  = "VECTOR_DB"
          value = "pgvector"
        },
        {
          name = "WEBUI_SECRET_KEY"
          valueFrom = {
            secretKeyRef = {
              name = local.state_secret_name
              key  = "secret-key"
            }
          }
        },
        # The ceiling on blocking operations is 40 out of the box, which a handful
        # of concurrent users is enough to exhaust, and the symptom is an
        # interface that hangs while the pods look idle.
        {
          name  = "THREAD_POOL_SIZE"
          value = "2000"
        },
        # Open WebUI reads a PersistentConfig setting from Redis on every access,
        # and a request touches dozens of them. Left to the default, the client
        # has no deadline on the connect: a Valkey cluster that stops answering
        # turns every one of those reads into a wait, and the whole interface
        # crawls even though the values are all still in PostgreSQL.
        #
        # Only the connect is bounded. REDIS_SOCKET_TIMEOUT, its read and write
        # companion, must stay unset: it lands on the subscriber connection the
        # websocket manager keeps open, which sits idle by design and waits for
        # messages, and a read timeout ends that wait as an error. The socket
        # then carries nothing, so a reply is written to the database and never
        # pushed to the browser, which sees it on the next page load.
        {
          name  = "REDIS_SOCKET_CONNECT_TIMEOUT"
          value = "2"
        }
      ]
    }
  }
}

resource "helm_release" "kubeai" {
  depends_on = [
    kubectl_manifest.namespace,
    kubectl_manifest.open_webui_admin_secret,
    kubectl_manifest.open_webui_redis_secret,
    kubectl_manifest.open_webui_state_secret,
  ]

  name      = "kubeai"
  namespace = var.namespace

  repository = "https://www.kubeai.org"
  chart      = "kubeai"
  version    = var.chart_version

  # Pulling the Open WebUI image takes a while.
  timeout = 1200
  wait    = true

  values = [yamlencode(local.values)]

  set_sensitive = var.huggingface_token != "" ? [{
    name  = "secrets.huggingface.token"
    type  = "string"
    value = var.huggingface_token
  }] : []
}

# Self registration, for real this time.
#
# Open WebUI turns the sign up link off by itself, in the same breath as it
# bootstraps the admin account: "Disable signup since we now have an admin". That
# write goes to the configuration store, so nothing in the environment can hold
# the switch on, and it happens again on any start that finds the database empty.
# Flipping it back is what the toggle in Admin Panel, Settings, General does, and
# this job does exactly that through the same API, once, after the release is up.
# The value it writes lands in Valkey, where it outlives the pod.
#
# A job spec is immutable, so a change of intent has to run a new one, hence
# force_new. Nothing re-runs it if the Open WebUI database is emptied under a job
# that already completed: "tofu apply -replace" on this resource does.
resource "kubectl_manifest" "open_webui_signup" {
  depends_on = [helm_release.kubeai]
  force_new  = true

  yaml_body = yamlencode({
    apiVersion = "batch/v1"
    kind       = "Job"
    metadata = {
      name      = "openwebui-signup"
      namespace = var.namespace
    }
    spec = {
      backoffLimit = 3
      template = {
        spec = {
          restartPolicy                = "OnFailure"
          nodeSelector                 = var.node_selector
          automountServiceAccountToken = false

          containers = [{
            name    = "signup"
            image   = var.signup_job_image
            command = ["python3", "-c", local.signup_script]

            env = [
              {
                name  = "BASE_URL"
                value = "http://${helm_release.kubeai.name}-open-webui.${var.namespace}.svc.cluster.local"
              },
              {
                name  = "ENABLE_SIGNUP"
                value = var.enable_signup
              },
              {
                name  = "ADMIN_EMAIL"
                value = var.admin_email
              },
              {
                name = "ADMIN_PASSWORD"
                valueFrom = {
                  secretKeyRef = {
                    name = local.admin_secret_name
                    key  = "password"
                  }
                }
              },
            ]

            securityContext = {
              runAsNonRoot             = true
              runAsUser                = 1000
              allowPrivilegeEscalation = false
              readOnlyRootFilesystem   = true
              capabilities = {
                drop = ["ALL"]
              }
            }
          }]
        }
      }
    }
  })

  # Fails the apply rather than leaving the switch in an unknown state.
  wait_for {
    condition {
      type   = "Complete"
      status = "True"
    }
  }

  timeouts {
    create = "10m"
  }
}

# Model custom resources, one manifest per file. The file names come from the
# filesystem, so the for_each keys are known at plan time. Reading the documents
# through kubectl_path_documents would not work here: this module carries a
# depends_on, which defers the read of every data source it holds to apply time,
# leaving the for_each keys unknown while planning.
#
# A model naming a cache profile that the configuration does not declare is
# rejected, so cacheProfile is dropped from every document when no profile is
# declared, rather than leaving the apply to fail on it. With a profile declared
# the document is passed through exactly as it was written, byte for byte.
locals {
  model_files     = var.models_path != "" ? fileset(var.models_path, "*.yaml") : toset([])
  model_documents = { for name in local.model_files : name => yamldecode(file("${var.models_path}/${name}")) }

  # spec is replaced wholesale rather than filtered key by key: a conditional has
  # to return the same type on both branches, and an object that has lost an
  # attribute is not the type of the one that still has it.
  model_manifests = {
    for name, document in local.model_documents : name => (
      var.cache_storage_class != "" ? file("${var.models_path}/${name}") : yamlencode(merge(document, {
        spec = { for field, setting in document.spec : field => setting if field != "cacheProfile" }
      }))
    )
  }
}

resource "kubectl_manifest" "models" {
  for_each   = local.model_manifests
  depends_on = [helm_release.kubeai]

  yaml_body          = each.value
  override_namespace = var.namespace
}
